# Copy to the repository-root .env for native startup; replace example credentials.
ASPNETCORE_URLS=http://127.0.0.1:5081
ACME_API_KEY=sk_test_replace_with_local_key
ACME_MERCHANT_ID=8B67BF88-BB8D-4EB5-ADFC-0F5C97C7ED67
ACME_ADVICE_URL=http://localhost:5080/notifications/payment-advice
ACME_ADVICE_USERNAME=replace_with_local_username
ACME_ADVICE_PASSWORD=replace_with_local_password
ACME_STATUS_WEBHOOK_URL=http://localhost:5080/notifications/transaction-status
ACME_WEBHOOK_SECRET=replace_with_local_webhook_secret
ACME_ENABLE_CONTROLS=true

# PaymentIntegration (its run command overrides ASPNETCORE_URLS to port 5080).
ACME_BASE_URL=http://127.0.0.1:5081
PAYMENT_DATABASE_CONNECTION_STRING='Host=127.0.0.1;Port=5432;Database=payment_integration;Username=payment_integration_app;Password=payment_integration_dev_only'
