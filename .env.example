# Local examples only; replace credentials in your ignored .env file.
ACME_API_KEY=sk_test_replace_with_local_key
ACME_MERCHANT_ID=8B67BF88-BB8D-4EB5-ADFC-0F5C97C7ED67
ACME_ADVICE_URL=http://localhost:5080/notifications/payment-advice
ACME_ADVICE_USERNAME=replace_with_local_username
ACME_ADVICE_PASSWORD=replace_with_local_password
ACME_STATUS_WEBHOOK_URL=http://localhost:5080/notifications/transaction-status
ACME_WEBHOOK_SECRET=replace_with_local_webhook_secret
ACME_ENABLE_CONTROLS=true

# PaymentIntegration PostgreSQL database
# Copy to .env for local development. Never commit your populated .env file.
# Set two different passwords before starting Docker Compose.
# Single-quote passwords to preserve literal dollar signs and hash characters.
POSTGRES_USER=postgres
POSTGRES_DB=payment_integration
POSTGRES_PASSWORD=
PAYMENT_DB_USER=payment_integration_app
PAYMENT_DB_PASSWORD=
POSTGRES_PORT=5432
