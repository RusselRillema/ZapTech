# Copy to the repository-root .env for Docker Compose; replace example credentials.
ASPNETCORE_URLS=http://+:8080
ACME_HTTP_PORT=5081
ACME_API_KEY=sk_test_replace_with_local_key
ACME_MERCHANT_ID=8B67BF88-BB8D-4EB5-ADFC-0F5C97C7ED67
ACME_ADVICE_URL=http://host.docker.internal:5080/notifications/payment-advice
ACME_ADVICE_USERNAME=replace_with_local_username
ACME_ADVICE_PASSWORD=replace_with_local_password
ACME_STATUS_WEBHOOK_URL=http://host.docker.internal:5080/notifications/transaction-status
ACME_WEBHOOK_SECRET=replace_with_local_webhook_secret
ACME_ENABLE_CONTROLS=true

# Docker server bootstrap only. Application credentials are fixed in setup.sql.
# Keep the administrator separate from payment_integration_app.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
